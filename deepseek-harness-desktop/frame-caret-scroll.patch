diff --git a/packages/client/ui-layout/src/client/AppFrame.module.css b/packages/client/ui-layout/src/client/AppFrame.module.css
index 5b71ebecfd..59d0cc0cb3 100644
--- a/packages/client/ui-layout/src/client/AppFrame.module.css
+++ b/packages/client/ui-layout/src/client/AppFrame.module.css
@@ -3,7 +3,15 @@
   display: grid;
   grid-template-rows: minmax(0, 1fr) auto;
   height: 100%;
-  overflow: hidden;
+  /* `clip`, not `hidden`. A collapsed right panel keeps its width and slides
+     off the frame's right edge (ui-sidebar-right), so the frame always carries
+     a scrollable overflow wider than its own box. Hidden overflow still makes
+     the frame a scroll container, and the reveal of a caret that moved inside
+     the composer (PageUp/PageDown) scrolls it like any other: the whole shell
+     shifts left by the caret's offset and a blank band the panel's width opens
+     along the right edge. The frame is a fixed shell that never scrolls, so it
+     clips its overflow without becoming a scroller. */
+  overflow: clip;
   background: var(--dsw-alias-bg-base);
 }
 
