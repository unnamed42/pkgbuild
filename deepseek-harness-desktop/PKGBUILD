# Maintainer: HarryLoong <xiangzelong@radxa.com>
#
# Builds the DeepSeek Harness *desktop* application from the upstream repository.
# Upstream publishes desktop releases for macOS and Windows only, although the
# sources already contain the packaging target and the shell's Linux behaviour
# (wayland app id, native menus, DOM shortcut dispatch, non-portal folder dialogs);
# only the target wiring, the release settings for an unsigned build, the two
# Linux-only runtime adjustments in linux-desktop.patch, the Linux system tray in
# tray-linux.patch, the serial release packing that pack-speed.patch parallelises, the
# message-locale pin that desktop-message-locale.patch adds to the Host environment, and the
# Electron 44.0.0 tray regression that electron-tray-fix.patch steps around were missing.
# frame-caret-scroll.patch is not packaging work: it fixes a shell bug this tag ships, where a
# collapsed right sidebar leaves the frame's column grid a scroll container and PageUp or PageDown
# in the composer scrolls that grid sideways, opening a blank band along the right edge; the patch
# adds the browser regression test for it alongside the fix and registers that test the way this
# repository registers every host-face e2e file -- in tsconfig.host.json's include and in the
# client project's exclusions (apps/web/tsconfig.json), which the client typecheck requires.
# The installed
# result is the same shape as the macOS and Windows releases: the Electron shell plus
# a complete dsh runtime, with Node.js, pnpm, CPython and the Office libraries
# bundled, so nothing is required from the system at runtime beyond the shared
# libraries listed below.
#
# The build downloads the pinned Electron distribution, the Node.js and CPython
# runtimes, and the Python wheels the bundled payload locks (scripts/primary-runtime/
# lock.json). Those are unlisted sources this PKGBUILD cannot checksum; the
# repository pins every one of them by SHA-256 and the runtime downloader enforces
# the digest before use. A source build takes roughly 15-25 minutes and about 6 GB of
# scratch space.
#
# makepkg reports references to $srcdir inside resources/app.asar. Those are CSS-module
# virtual paths the client bundler writes into `//#region` comments; the same comments
# carry the packaging host's paths in the macOS and Windows releases. Nothing resolves
# them at runtime -- the application locates every file relative to its own directory.

pkgname=deepseek-harness-desktop
_tag=dsh-v0.2.1-alpha.4
pkgver=0.2.1alpha.4
pkgrel=1
pkgdesc='DeepSeek Harness desktop application (Electron shell and bundled dsh runtime)'
arch=('x86_64')
url='https://github.com/deepseek-ai/deepseek-harness'
license=('MIT')
depends=(
  'alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'expat' 'glib2' 'gtk3' 'libcups'
  'libx11' 'libxcb' 'libxcomposite' 'libxdamage' 'libxext' 'libxfixes'
  'libxkbcommon' 'libxrandr' 'mesa' 'nss' 'pango' 'systemd-libs' 'xdg-utils'
)
optdepends=(
  'zenity: native directory dialogs for local directory selection'
  'kdialog: native directory dialogs on Plasma'
)
makedepends=('git' 'nodejs' 'pnpm' 'python')
options=('!strip' '!debug')
source=(
  "$pkgname::git+https://github.com/deepseek-ai/deepseek-harness.git#tag=$_tag"
  'linux-desktop.patch'
  'deepseek-harness-linux.env'
  'tray-linux.patch'
  'pack-speed.patch'
  'electron-tray-fix.patch'
  'desktop-message-locale.patch'
  'frame-caret-scroll.patch'
)
sha256sums=(
  'SKIP'
  '7b5be0aaf0a4cc5dab29fc49b00d1e96c7ef338de272c45400881110a366545a'
  'c9783ffd57bf481f89ec59beb6047c7cf40098e4790c6098bf60370c408a4c7d'
  '75d742a87e5d450e0f4e0ca11ced22b98e82380481fc48ccd76af9e565eead37'
  '503628ec2a0699d91c91d64502931a70fc5dc831f772558f574602bae4150d62'
  'ed5f877ee06f74cae620ca82e68219b543e5f572bba270e340a79ccaed0db925'
  'aefede4e1c7c03c0f92847b145460393aa4a584fb3b8890e935dab3b70c16f19'
  '75cd0a669ffc13bce9a8009f379071fbac6febbacfcfcb369c09f35bf335f338'
)

prepare() {
  cd "$pkgname"

  # makepkg reuses this working copy for a re-run (and --noextract skips the reset):
  # restore the tracked files and drop the files the patches add, so the patches below
  # always apply to a clean tree.
  git checkout -- .
  rm -f apps/desktop/scripts/linux-runtime-adjustments.ts apps/web/tests/frame-caret-scroll.e2e.ts

  # Linux desktop target, unsigned release settings, and the Electron-safe sharp
  # build plus the LibreOfficeKit engine probe fix the ASAR layout needs.
  patch -Np1 --no-backup-if-mismatch -i "$srcdir/linux-desktop.patch"

  # The shell already owns the tray; on Linux only the platform gate, the icon path
  # and its regression test were missing.
  patch -Np1 --no-backup-if-mismatch -i "$srcdir/tray-linux.patch"

  # The pack step is one pnpm per tarball, and this build packs over three hundred of
  # them; parallelise it and stop its per-tarball file listing from burying the log.
  patch -Np1 --no-backup-if-mismatch -i "$srcdir/pack-speed.patch"

  # Electron 44.0.0 registers its StatusNotifierItem under a name the desktop's watcher
  # cannot resolve, so the tray never appears; 44.1.0 carries the upstream fix.
  patch -Np1 --no-backup-if-mismatch -i "$srcdir/electron-tray-fix.patch"

  # The Host environment is the parent of every tool command, and DSH tells a sandbox
  # denial apart from an ordinary command failure by matching English kernel strings in a
  # child's stderr. A translated message locale hides every denial from the model, so pin
  # the message catalogue here rather than depending on how the user launched the app.
  patch -Np1 --no-backup-if-mismatch -i "$srcdir/desktop-message-locale.patch"

  # The shell's column grid clips its overflowing right panel with `overflow: hidden`,
  # which still leaves the frame a scroll container: PageUp or PageDown in the composer
  # moves the caret, the browser reveals it, and the frame scrolls sideways by the caret's
  # offset -- the shell jumps left and a blank band the collapsed panel's width opens along
  # the right edge. Clipping without scrolling is the fix; drop this patch once it is upstream.
  patch -Np1 --no-backup-if-mismatch -i "$srcdir/frame-caret-scroll.patch"

  # The Linux target reads its release settings from a dotenv file beside the app.
  install -Dm644 "$srcdir/deepseek-harness-linux.env" apps/desktop/.env.linux
}

build() {
  cd "$pkgname"

  # Build with the toolchain the makedepends declare. A different Node earlier in PATH,
  # such as a bundled runtime, carries no Node-API headers and the native addon build
  # needs them; the same lookup also fixes which pnpm bootstraps the workspace.
  export PATH="/usr/bin:$PATH"

  # A compile cache (NODE_COMPILE_CACHE) belongs to the user's environment, not to a build:
  # upstream CI enables one, and this build runs hundreds of concurrent Node children that
  # would share a single cache directory.
  export NODE_DISABLE_COMPILE_CACHE=1

  # Electron binary for a working Linux tray. electron-builder packages the directory
  # prepare-runtime.ts downloads, so this picks the binary without touching the lockfile.
  # The runtime's prebuilt native addon (node-addon-require-builtin) accepts only the exact
  # fingerprints 43.0.0, 44.0.0 and 45.0.0-alpha.6, and 44.0.0 is the release whose
  # StatusNotifierItem registration the desktop shell's tray cannot use; 44.5.1, which carries
  # the upstream fix, is refused and fails prepare:dsh. 43.0.0 is the newest allowed version
  # that predates the regression, and it was verified here: the shell starts on it and its tray
  # item registers with org.kde.StatusNotifierWatcher (:1.xxxx/org/chromium/StatusNotifierItem/1).
  # Upstream publishes no Linux desktop release, so this pin is ours to carry: drop it once the
  # runtime's addon (deepseek-ai/dsh-node-addon-require-builtin) adds a fingerprint for an
  # Electron that also carries the tray fix.
  export DSH_DESKTOP_ELECTRON_VERSION=43.0.0

  # The Electron archive and the SHASUMS256.txt @electron/get checks it against both come from
  # GitHub's release CDN, and that checksum file is fetched on every run, so a cached archive
  # does not help while github.com is unreachable: the connection itself times out. npmmirror
  # mirrors the release verbatim, checksum file included, and @electron/get still verifies the
  # archive against it. Set ELECTRON_MIRROR to the GitHub release base to fetch from there.
  export ELECTRON_MIRROR="${ELECTRON_MIRROR:-https://registry.npmmirror.com/-/binary/electron/}"

  # The repository pins its own pnpm through packageManager; the system package bootstraps it.
  pnpm install --frozen-lockfile

  # makepkg reuses the working copy across tags and git ignores generated output, so a re-run
  # at a new tag keeps the previous tag's `lib/` trees; the bundle step discovers workspace
  # members by directory and then fails on the packages the new tag renamed or deleted.
  # The repository's own cleaner removes that output, and it also removes
  # apps/desktop/.desktop-build, which holds the pinned upstream downloads; keep that cache.
  local downloads
  if [[ -d apps/desktop/.desktop-build/downloads ]]; then
    downloads=$(mktemp -d)
    mv apps/desktop/.desktop-build/downloads "$downloads/downloads"
  fi
  pnpm run clean
  if [[ -n ${downloads:-} ]]; then
    install -d apps/desktop/.desktop-build
    mv "$downloads/downloads" apps/desktop/.desktop-build/downloads
    rmdir "$downloads"
  fi

  # Assemble the unpacked application: the Electron shell, the dsh runtime with its
  # production dependency closure, and the bundled Node.js/pnpm/CPython payload. The
  # target runs its own packed-runtime smoke checks -- native module loading, a real
  # image decode, a PTY, ripgrep, and a DOCX/XLSX/PPTX to PDF conversion through the
  # bundled Python -- and fails the build when any of them fails.
  pnpm --filter @deepseek-ai/dsh-desktop run package:dir
}

package() {
  cd "$pkgname"
  local appdir=apps/desktop/.desktop-build/targets/linux-x64/artifacts/linux-unpacked
  local desktop=deepseek-ai-dsh-desktop

  # Arch layout: private application payload under /usr/lib, entry point in /usr/bin.
  install -d "$pkgdir/usr/lib/$pkgname" "$pkgdir/usr/bin"
  cp -a "$appdir/." "$pkgdir/usr/lib/$pkgname/"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/$pkgname" <<'EOF'
#!/bin/sh
# Chromium's sandbox uses unprivileged user namespaces, which Arch enables by default;
# pass --no-sandbox only if the kernel reports them as unavailable.
exec /usr/lib/deepseek-harness-desktop/deepseek-harness "$@"
EOF

  # The file name matches the application's Wayland app id, so desktop shells and
  # window lists can map a running window back to this entry and its icon.
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/$desktop.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=DeepSeek Harness
Comment=DeepSeek Harness desktop application
Exec=$pkgname %U
Icon=deepseek-harness
Terminal=false
StartupNotify=true
StartupWMClass=$desktop
Categories=Development;
Keywords=AI;agent;deepseek;harness;dsh;
MimeType=x-scheme-handler/dsh;
EOF

  install -Dm644 apps/desktop/resources/icon.png \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/deepseek-harness.png"
  # The same artwork as a vector, which is what icon themes prefer at every size.
  install -Dm644 apps/desktop/resources/icon.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/deepseek-harness.svg"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
